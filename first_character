public class Main {
    public static void main(String[] args) {
        String s = "aabbcddee";

        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);

            if (s.indexOf(ch) == s.lastIndexOf(ch)) {
                System.out.println("First non-repeating: " + ch);
                return;
            }
        }

        System.out.println("No non-repeating character");
    }
}
