
interface Payment {
    int MAX_AMOUNT = 50000;

    void pay();
}

class UPI implements Payment {

    public void pay() {
        System.out.println("Payment using UPI");
        System.out.println("Maximum amount: " + MAX_AMOUNT);
    }
}

public class Main {
    public static void main(String[] args) {
        UPI u = new UPI();
        u.pay();
    }
}
