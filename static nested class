class Student {
    String name = "Tabrej";
    int age = 20;

    class Details {
        void show() {
            System.out.println("Name: " + name);
            System.out.println("Age: " + age);
        }
    }

    public static void main(String[] args) {
        Student s = new Student();
        Student.Details d = s.new Details();

        d.show();
    }
}
